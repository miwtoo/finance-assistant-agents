# Firefly III API
FIREFLY_BASE_URL=http://localhost:8080
FIREFLY_TOKEN=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Slip image source directory (Resilio Sync target)
SLIPS_RAW_DIR=./slips/raw
# Host path mounted read-only by docker-compose.yml
SLIPS_RAW_DIR_HOST=./slips/raw

# Database
DB_PATH=./data/app.sqlite

# Cloudflare Access authentication
# Header name to check for authenticated user email
CF_ACCESS_HEADER=Cf-Access-Authenticated-User-Email
# Set to "true" to bypass Cloudflare Access check during local development
CF_ACCESS_DEV_BYPASS=false
